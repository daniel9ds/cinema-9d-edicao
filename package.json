{
  "name": "cinema-9d-edicao",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Método local reutilizável para edição de fala, legendas e motion com Remotion.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "edicao": "node --import tsx scripts/cli.ts",
    "doctor": "node --import tsx scripts/cli.ts doctor",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "setup": "node --import tsx scripts/setup.ts",
    "instalar:skill": "node --import tsx scripts/install-skill.ts"
  },
  "dependencies": {
    "remotion": "4.0.535",
    "@remotion/cli": "4.0.535",
    "@remotion/bundler": "4.0.535",
    "@remotion/renderer": "4.0.535",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "@types/node": "22.19.11",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  }
}
